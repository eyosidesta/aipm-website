ACCESS_TOKEN_SECRET=replace-with-a-long-random-value
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-value
CORS_ORIGIN=http://localhost:3000

# Either set DATABASE_URL (a full connection string), OR fill in the DB_* vars below.
# DATABASE_URL=postgres://user:password@host:5432/dbname
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aipm
DB_USER=postgres
DB_PASSWORD=replace-with-real-password
DB_SSL=false
NODE_ENV=development
